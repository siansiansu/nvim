#!/bin/sh
# Refuses a commit whose staged changes contain a secret, before it reaches
# history. Enabled per clone: git config core.hooksPath .githooks
command -v gitleaks >/dev/null || { echo "pre-commit: gitleaks not found, brew install gitleaks" >&2; exit 1; }
exec gitleaks git --pre-commit --staged --redact --no-banner
